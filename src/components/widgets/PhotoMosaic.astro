---
import type { CollectionEntry } from 'astro:content'
import { getSlugFromId } from '@/utils/slug'
import { getPostImage } from '@/utils/postImage'

type Props = {
  posts: Array<CollectionEntry<'posts'>>
}

const { posts } = Astro.props as Props

const tiles = await Promise.all(
  posts.map(async (post) => {
    const optimized = await getPostImage(post, { format: 'webp', width: 900 })
    if (!optimized) return null

    return {
      href: `/${getSlugFromId(post.id)}/`,
      title: post.data.title,
      src: optimized.src,
      attributes: optimized.attributes
    }
  })
)

const images = tiles.filter(Boolean) as Array<NonNullable<(typeof tiles)[number]>>
---

{images.length > 0 ? (
  <div class="photo-mosaic" aria-label="Índice de imágenes">
    {images.map((img) => (
      <a class="photo-tile" href={img.href} title={img.title} aria-label={`Abrir: ${img.title}`}>
        <img
          src={img.src}
          width={img.attributes.width}
          height={img.attributes.height}
          alt={img.title}
          loading="lazy"
          decoding="async"
        />
      </a>
    ))}
  </div>
) : (
  <p class="photos-empty">No hay imágenes todavía.</p>
)}

<style>
  .photos-empty {
    margin: 0;
    color: var(--text-secondary);
  }

  /* Masonry sin JS: organico y silencioso (no "grid" perceptible). */
  .photo-mosaic {
    column-count: 2;
    column-gap: 0.75rem;
  }

  @media (min-width: 900px) {
    .photo-mosaic {
      column-count: 3;
    }
  }

  .photo-tile {
    display: block;
    break-inside: avoid;
    margin: 0 0 0.75rem 0;
    text-decoration: none;
    border-radius: 8px;
    overflow: hidden;
    background: var(--astro-code-background);
    border: 0.5px solid var(--border);
    transition:
      border-color 0.2s ease-out,
      background 0.2s ease-out,
      opacity 0.2s ease-out;
  }

  .photo-tile:hover {
    border-color: color-mix(in srgb, var(--text-tertiary) 65%, transparent);
    background: color-mix(in srgb, var(--selection) 75%, transparent);
  }

  .photo-tile img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>

