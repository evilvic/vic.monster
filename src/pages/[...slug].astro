---
import { type CollectionEntry, getCollection } from 'astro:content'
import PostLayout from '@/layouts/PostLayout.astro'
import { render } from 'astro:content'
import { getSlugFromId } from '@/utils/slug'
import { getPostOgImage } from '@/utils/postImage'
import { getExcerpt } from '@/utils/excerpt'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts
    .filter((post) => !post.id.startsWith('_'))
    .map((post) => ({
      params: { slug: getSlugFromId(post.id) },
      props: post
    }))
}

type Props = CollectionEntry<'posts'>

const post = Astro.props
const { Content, remarkPluginFrontmatter } = await render(post)

const readingTime = remarkPluginFrontmatter.readingTime
const toc = remarkPluginFrontmatter.toc || []

// A post with its own image is shared with it
const ogImage = (await getPostOgImage(post)) ?? undefined

// Its own words describe it: the frontmatter description if set, else its opening
const description = post.data.description ?? getExcerpt(post.body)
---

<PostLayout
  {...post.data}
  readingTime={readingTime}
  toc={toc}
  ogImage={ogImage}
  description={description}
>
  <Content />
</PostLayout>
